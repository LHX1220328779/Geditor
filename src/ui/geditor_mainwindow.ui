    <string>cc</string>
   </property>
  </action>
  <action name="show_tra">
   <property name="checkable">
    <bool>true</bool>
   </property>
   <property name="checked">
    <bool>true</bool>
   </property>
   <property name="text">
    <string>轨迹图层</string>
   </property>
  </action>
  <action name="view_pan">
