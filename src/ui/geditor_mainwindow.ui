    <string>检查所有中心线的前续/后继关系是否符合 起始/终止/中间 角色</string>
   </property>
  </action>
  <action name="action_QUICK_ADAPTIVE_BOUNDARY">
   <property name="text">
    <string>自适应生成边界(平滑)</string>
   </property>
   <property name="toolTip">
    <string>按"双开/单开均匀碾压"参数逐顶点变宽生成左右边界，接缝处自动 taper 平滑</string>
   </property>
  </action>
  <action name="action_QUICK_VIZ_ROAD_RIGHT">
   <property name="checkable">
    <bool>true</bool>
   </property>
   <property name="text">
    <string>可视化 road_right</string>
   </property>
   <property name="toolTip">
    <string>勾选后：road_right=1 的中心线左右边界围成的区域从浅白色改为浅绿色，便于总览均匀碾压路段</string>
   </property>
  </action>
  <action name="actioncc">
